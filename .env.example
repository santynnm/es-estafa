# API key de Google AI Studio (tier gratuito). Nunca commitear el valor real.
# Se obtiene en https://aistudio.google.com/apikey
# Usada únicamente del lado servidor (api/analyze.ts) — nunca se expone al navegador.
GEMINI_API_KEY=

# Modelo de Gemini a usar. Opcional: si se omite, se usa gemini-3.5-flash-lite.
# Google va deprecando modelos con el tiempo (ej: gemini-2.0-flash y
# gemini-2.5-flash-lite dejaron de estar disponibles para cuentas nuevas) — si
# empieza a fallar con 404 "model ... is no longer available", correr
# scripts/check-models.mjs con tu API key para ver qué modelos responden OK
# (node scripts/check-models.mjs TU_API_KEY), o revisar
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase Auth (Día 5-6A). Se obtienen en el dashboard del proyecto de
# Supabase -> Settings -> API. Son públicas por diseño (van al bundle del
# navegador) — NUNCA pongas acá la service role key, esa no debe existir del
# lado del cliente.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Usuario de evaluación (corrección previa al Día 7). /api/analyze y
# /api/extract-image ahora requieren sesión — scripts/eval-classifier.mts y
# scripts/eval-image-pipeline.mts inician sesión con estas credenciales para
# poder llamarlos. Usá una cuenta de prueba dedicada (podés crearla con
# "Crear cuenta" en la propia app, o desde el dashboard de Supabase:
# Authentication -> Users -> Add user), nunca una cuenta real. Nunca
# commitear valores reales acá ni en ningún otro lado del repo.
EVAL_USER_EMAIL=
EVAL_USER_PASSWORD=

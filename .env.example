# API key de Google AI Studio (tier gratuito). Nunca commitear el valor real.
# Se obtiene en https://aistudio.google.com/apikey
# Usada únicamente del lado servidor (api/analyze.ts) — nunca se expone al navegador.
GEMINI_API_KEY=

# Modelo de Gemini a usar. Opcional: si se omite, se usa gemini-3.5-flash-lite.
# Google va deprecando modelos con el tiempo (ej: gemini-2.0-flash y
# gemini-2.5-flash-lite dejaron de estar disponibles para cuentas nuevas) — si
# empieza a fallar con 404 "model ... is no longer available", correr
# scripts/check-models.mjs con tu API key para ver qué modelos responden OK
# (node scripts/check-models.mjs TU_API_KEY), o revisar
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase Auth (Día 5-6A). Se obtienen en el dashboard del proyecto de
# Supabase -> Settings -> API. Son públicas por diseño (van al bundle del
# navegador) — NUNCA pongas acá la service role key, esa no debe existir del
# lado del cliente.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Usuario de evaluación (corrección previa al Día 7). /api/analyze y
# /api/extract-image ahora requieren sesión — scripts/eval-classifier.mts y
# scripts/eval-image-pipeline.mts inician sesión con estas credenciales para
# poder llamarlos. Usá una cuenta de prueba dedicada (podés crearla con
# "Crear cuenta" en la propia app, o desde el dashboard de Supabase:
# Authentication -> Users -> Add user), nunca una cuenta real. Nunca
# commitear valores reales acá ni en ningún otro lado del repo.
EVAL_USER_EMAIL=
EVAL_USER_PASSWORD=

# Brevo (Día 7A, corrección 7A.1 — reemplaza a Resend) — envío de alertas
# por email a contactos familiares. Se obtiene en el dashboard de Brevo:
# Settings -> SMTP & API -> API Keys -> "Generate a new API key". Usada
# únicamente del lado servidor (api/_lib/brevo.ts) — nunca se expone al
# navegador. Cuenta gratuita (plan Free), sin dominio propio verificado:
# no se contratan planes pagos ni se compra/registra un dominio.
BREVO_API_KEY=

# Email del remitente verificado en Brevo (Settings -> Senders, Domains &
# Dedicated IPs -> Add a sender, con el código de verificación que Brevo
# manda a esa casilla). Sin un dominio propio autenticado (DKIM/SPF), la
# entregabilidad no es equivalente a la de un dominio propio — puede haber
# más probabilidad de que el email caiga en spam.
BREVO_SENDER_EMAIL=

# Nombre para mostrar del remitente configurado en Brevo (ej: "¿Es estafa?").
BREVO_SENDER_NAME=

# Corrección de seguridad post Día 7A. Se obtiene en el dashboard de
# Supabase -> Settings -> API -> "service_role" (secreta, distinta de la
# anon key). Usada EXCLUSIVAMENTE del lado servidor, solo dentro de
# api/_lib/supabaseAdmin.ts, solo para transicionar el estado de
# alerts_sent (esa tabla ya no acepta insert/update con la sesión normal
# del usuario). NUNCA con prefijo VITE_, NUNCA importada desde src/, NUNCA
# en logs ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# Corrección 7A.2A.1 — solo para scripts/eval-email-quota.mts (evaluación
# reproducible del mecanismo de cupos diarios de email, no se usa en
# ningún endpoint ni en producción). Personal Access Token de Supabase
# (dashboard -> cuenta -> Access Tokens, empieza con "sbp_"), usado
# exclusivamente para comparar la función desplegada contra la migración
# versionada y para crear/eliminar un schema SQL aislado y descartable
# donde corren las pruebas de límites y concurrencia. Se lee solo de esta
# variable de entorno; el script nunca lo escribe a un archivo, nunca lo
# imprime y nunca lo incluye en un mensaje de error. NUNCA lo pongas acá
# con un valor real ni lo commitees — pasalo solo en memoria de tu shell
# (ej. exportándolo antes de correr `npm run eval:quota`), y nunca lo
# reutilices como variable del frontend.
SUPABASE_ACCESS_TOKEN=

# Ref del proyecto de Supabase (se ve en la URL del dashboard, o en
# VITE_SUPABASE_URL: https://<ref>.supabase.co). Usado junto con
# SUPABASE_ACCESS_TOKEN por scripts/eval-email-quota.mts para llamar a la
# Management API. No es secreto por sí solo, pero tampoco tiene uso fuera
# de ese script.
SUPABASE_PROJECT_REF=

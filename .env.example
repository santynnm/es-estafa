# API key de Google AI Studio (tier gratuito). Nunca commitear el valor real.
# Se obtiene en https://aistudio.google.com/apikey
# Usada únicamente del lado servidor (api/analyze.ts) — nunca se expone al navegador.
GEMINI_API_KEY=

# Modelo de Gemini a usar. Opcional: si se omite, se usa gemini-3.5-flash-lite.
# Google va deprecando modelos con el tiempo (ej: gemini-2.0-flash y
# gemini-2.5-flash-lite dejaron de estar disponibles para cuentas nuevas) — si
# empieza a fallar con 404 "model ... is no longer available", correr
# scripts/check-models.mjs con tu API key para ver qué modelos responden OK
# (node scripts/check-models.mjs TU_API_KEY), o revisar
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite
